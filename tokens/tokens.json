{
  "$description": "PrimeTax design tokens (Brief v2.0). Source of truth for code is styles/globals.css.",
  "color": {
    "prime-white": { "$type": "color", "$value": "#FFFFFF", "$description": "Primary background, cards, content" },
    "charcoal": { "$type": "color", "$value": "#252525", "$description": "Logo, headings, primary text" },
    "graphite": { "$type": "color", "$value": "#646464", "$description": "Secondary text, metadata" },
    "warm-gray": { "$type": "color", "$value": "#F4F2EE", "$description": "Secondary backgrounds, panels" },
    "champagne-gold": { "$type": "color", "$value": "#B79A62", "$description": "Accent lines and small details only; not for body text on white" },
    "border-gray": { "$type": "color", "$value": "#E6E2DA", "$description": "Borders, dividers" }
  },
  "font": {
    "primary": { "$type": "fontFamily", "$value": "Inter, sans-serif" },
    "editorial": { "$type": "fontFamily", "$value": "Source Serif 4, serif", "$description": "Quotations and report covers only" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "8px" },
    "button": { "$type": "dimension", "$value": "4px" }
  },
  "size": {
    "content-max-width": { "$type": "dimension", "$value": "1240px" }
  }
}
